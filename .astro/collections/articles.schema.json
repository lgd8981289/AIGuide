{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "module": {
      "default": "interview",
      "type": "string",
      "enum": [
        "interview",
        "tutorial"
      ]
    },
    "qnum": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "faqAnswer": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "category",
    "qnum",
    "date"
  ]
}