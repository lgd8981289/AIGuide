{
  "name": "aiguide",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "sync": "node scripts/sync-content.mjs && npm run sync:course && npm run img:watermark",
    "sync:content": "node scripts/sync-content.mjs",
    "img:watermark": "node scripts/py.mjs scripts/watermark-images.py",
    "img:optimize": "node scripts/py.mjs scripts/optimize-images.py",
    "build": "node scripts/article-url-workflow.mjs synced && npm run img:optimize && astro build && npm run build:post && npm run check:seo && pagefind --site dist && npm run check:course",
    "build:fast": "astro build",
    "preview": "astro preview",
    "build:post": "node scripts/postbuild.mjs",
    "check:seo": "node scripts/article-url-workflow.mjs built && python3 scripts/check-seo.py",
    "check:urls": "node scripts/article-url-workflow.mjs source",
    "check:companies": "node scripts/check-company-questions.mjs",
    "urls:init": "node scripts/article-url-workflow.mjs init",
    "urls:record": "node scripts/article-url-workflow.mjs record",
    "test:urls": "node --test scripts/tests/article-url-*.test.mjs",
    "bing:preview": "python3 scripts/submit-bing.py",
    "bing:submit": "python3 scripts/submit-bing.py --submit",
    "sync:course": "node scripts/sync-course.mjs",
    "test:course": "node --test scripts/tests/course-*.test.mjs",
    "test:sync": "node --test scripts/tests/sync-content.test.mjs && node scripts/py.mjs scripts/tests/test_image_pipeline.py",
    "check:course": "node scripts/check-course.mjs && python3 scripts/check-course-search.py",
    "export:github": "node scripts/export-github.mjs",
    "test:github": "node --test scripts/tests/github-articles.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.1.2",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "sharp": "0.35.4",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
