# build output
dist/
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*

# environment
.DS_Store
操作手册.md

# 本地发布脚本（含服务器密码，切勿提交）
deploy.sh

# 图片原图（由 npm run sync 生成，可重建，不进仓库）
img-src/

# 网站同步正文、课程与构建配图保留本地；已发布文章通过 npm run export:github 导出到 articles/ 提交
/src/content/articles/
/src/content/course/
/public/course-assets/
/.course-sync-*/
/public/img/

# 浏览器调试产物可能包含文章正文或截图
/.playwright-mcp/

# IndexNow 站点验证文件由本地部署配置管理
public/*.txt

# Python 校验脚本缓存
__pycache__/

# Bing 所有权验证文件由本地发布配置管理
/public/BingSiteAuth.xml
docs
.env

# Bing URL 提交的本地状态、锁和回执
/.bing/

# 图片指纹与处理缓存，仅本地使用
/.cache/image-pipeline/

# 上传前的网址清单：失败时本地保留，不提交；已发布保护表在 scripts/ 下提交
/.cache/article-urls/

# 渠道待审稿只在本地审阅，不随代码推送公开
/publishing/
