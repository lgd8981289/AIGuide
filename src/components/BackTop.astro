---
// 右下角悬浮按钮：环形进度显示当前文章阅读比例，滚动后出现，点击回到顶部
// 仅在文章页引入（阅读进度只对长文有意义）
---

<div class="backtop-wrap" data-pagefind-ignore>
  <button id="backtop" aria-label="回到顶部" title="回到顶部">
    <svg class="bt-ring-svg" viewBox="0 0 44 44" aria-hidden="true">
      <circle class="bt-ring-bg" cx="22" cy="22" r="19"></circle>
      <circle class="bt-ring" cx="22" cy="22" r="19"></circle>
    </svg>
    <span class="bt-pct" id="backtop-pct">0%</span>
    <svg class="bt-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 19V5"></path>
      <path d="m5 12 7-7 7 7"></path>
    </svg>
  </button>
</div>

<script>
  const wrap = document.querySelector<HTMLElement>(".backtop-wrap");
  const btn = document.getElementById("backtop");
  const ring = document.querySelector<SVGCircleElement>(".bt-ring");
  const pct = document.getElementById("backtop-pct");

  if (wrap && btn && ring && pct) {
    const CIRC = 2 * Math.PI * 19; // 环形周长

    let ticking = false;
    const update = () => {
      ticking = false;
      const doc = document.documentElement;
      const total = doc.scrollHeight - window.innerHeight;
      const ratio = total > 0 ? Math.min(1, Math.max(0, window.scrollY / total)) : 0;

      ring.style.strokeDashoffset = String(CIRC * (1 - ratio));
      const shown = Math.round(ratio * 100);
      pct.textContent = `${shown}%`;

      const on = window.scrollY > 360;
      wrap.classList.toggle("show", on);
      // 已到顶部时只显示箭头，读到底时只显示百分比
      btn.classList.toggle("at-top", ratio < 0.01);
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    update();

    btn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }
</script>
