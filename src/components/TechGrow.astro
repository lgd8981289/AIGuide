---
// TechGrow 公众号引流组件
// 开关与生效设备见 src/data/site.ts。是否对本页生效由页面按 TECHGROW.random
// 在构建时抽样后通过 gated 传入（见 isGatedArticle），保证与 Article.hasPart 标记一致。
// HTML 保留全文，受限区域通过 Article.hasPart 标记；搜索引擎的实际渲染和收录仍需在站长平台验证。
import { TECHGROW } from "../data/site";

interface Props {
  /** 页面级抽样结果；false 时不加载引流脚本，全文直接可见 */
  gated?: boolean;
}
const { gated = true } = Astro.props;
const enabled = TECHGROW.enabled && gated;
const cfg = {
  blogId: TECHGROW.blogId,
  name: TECHGROW.name,
  keyword: TECHGROW.keyword,
  qrcode: TECHGROW.qrcode,
  type: TECHGROW.type,
  expires: TECHGROW.expires,
  // 固定 1.0：页面级抽样已在构建时完成，命中即对本页 100% 生效；
  // 若沿用 TECHGROW.random 会二次抽样，实际门禁率被平方。
  random: "1.0",
  allowMobile: TECHGROW.allowMobile,
};
---

{
  enabled && (
    <>
      <link
        href="https://qiniu.techgrow.cn/readmore/dist/readmore.css"
        type="text/css"
        rel="stylesheet"
      />
      <script is:inline src="https://qiniu.techgrow.cn/readmore/dist/readmore.js" />
      <script is:inline define:vars={{ cfg }}>
        (function () {
          var regex =
            /(phone|pad|pod|iPhone|iPod|ios|iPad|Android|Mobile|BlackBerry|IEMobile|MQQBrowser|JUC|Fennec|wOSBrowser|BrowserNG|WebOS|Symbian|Windows Phone)/i;
          var isMobile = navigator.userAgent.match(regex);
          if (!isMobile || (isMobile && cfg.allowMobile)) {
            try {
              var container = document.getElementById("readmore-container");
              if (!container) return;
              var marker = container.querySelector(".gated-content");
              function previewHeight() {
                if (!marker) return "auto";
                var top = marker.getBoundingClientRect().top - container.getBoundingClientRect().top + container.scrollTop;
                if (top <= 100) return "auto";
                // 插件的渐变遮罩向上覆盖 200px，给它单独留出空间，避免压住速答配图。
                var mask = container.querySelector("#readmore-mask");
                var maskHeight = mask ? mask.getBoundingClientRect().height : 200;
                return String(Math.ceil(top + maskHeight + 24));
              }
              var plugin = new ReadmorePlugin();
              plugin.init({
                id: "readmore-container",
                blogId: cfg.blogId,
                name: cfg.name,
                keyword: cfg.keyword,
                qrcode: cfg.qrcode,
                type: cfg.type,
                height: previewHeight(),
                expires: cfg.expires,
                random: cfg.random,
              });
              if (marker) {
                function syncHeight() {
                  // 解锁后插件会恢复全文；后续图片加载、窗口缩放不能重新截断文章。
                  var wrapper = container.querySelector("#readmore-wrapper");
                  if (!wrapper || !wrapper.getBoundingClientRect().height || container.style.overflow !== "hidden") return;
                  var height = previewHeight();
                  if (height !== "auto" && container.style.height !== height + "px") {
                    container.style.height = height + "px";
                  }
                }
                syncHeight();
                // 同时跟踪容器宽度和速答内容尺寸，兼容图片晚加载、侧栏切换及文字换行。
                var observer = new ResizeObserver(function () {
                  requestAnimationFrame(syncHeight);
                });
                observer.observe(container);
                for (var child of container.children) {
                  if (child === marker) break;
                  observer.observe(child);
                }
              }
            } catch (e) {
              console.warn(
                "readmore plugin occurred error: " + e.name + " | " + e.message
              );
            }
          }
        })();
      </script>
    </>
  )
}
