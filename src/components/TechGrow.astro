---
// TechGrow 公众号引流组件
// 默认关闭（enabled: false），不加载任何外部脚本，文章全文直接可见。
// 开启步骤见 src/data/site.ts 中 TECHGROW 的注释。
// 机制说明：锁定发生在浏览器端（JS 遮罩），HTML 源码始终完整，对 SEO 无损。
import { TECHGROW } from "../data/site";

const enabled = TECHGROW.enabled;
const cfg = {
  blogId: TECHGROW.blogId,
  name: TECHGROW.name,
  keyword: TECHGROW.keyword,
  qrcode: TECHGROW.qrcode,
  type: TECHGROW.type,
  expires: TECHGROW.expires,
  random: TECHGROW.random,
  allowMobile: TECHGROW.allowMobile,
};
---

{
  enabled && (
    <>
      <link
        href="https://qiniu.techgrow.cn/readmore/dist/readmore.css"
        type="text/css"
        rel="stylesheet"
      />
      <script is:inline src="https://qiniu.techgrow.cn/readmore/dist/readmore.js" />
      <script is:inline define:vars={{ cfg }}>
        (function () {
          var regex =
            /(phone|pad|pod|iPhone|iPod|ios|iPad|Android|Mobile|BlackBerry|IEMobile|MQQBrowser|JUC|Fennec|wOSBrowser|BrowserNG|WebOS|Symbian|Windows Phone)/i;
          var isMobile = navigator.userAgent.match(regex);
          if (!isMobile || (isMobile && cfg.allowMobile)) {
            try {
              var container = document.getElementById("readmore-container");
              if (!container) return;
              var height = "auto";
              var heads = container.querySelectorAll("h2");
              var marker = null;
              for (var i = 0; i < heads.length; i++) {
                if (heads[i].textContent.indexOf("知识点详解") !== -1) {
                  marker = heads[i];
                  break;
                }
              }
              // 面试题：遮罩从「知识点详解」开始，让「面试速答」保持免费可见作为钩子
              // 教程类没有这个标题，退到第一个小节标题（开头一段导语仍然可读）
              if (!marker && heads.length > 0) marker = heads[0];
              if (marker) {
                var top = marker.offsetTop - container.offsetTop;
                if (top > 100) height = String(top);
              }
              var plugin = new ReadmorePlugin();
              plugin.init({
                id: "readmore-container",
                blogId: cfg.blogId,
                name: cfg.name,
                keyword: cfg.keyword,
                qrcode: cfg.qrcode,
                type: cfg.type,
                height: height,
                expires: cfg.expires,
                random: cfg.random,
              });
            } catch (e) {
              console.warn(
                "readmore plugin occurred error: " + e.name + " | " + e.message
              );
            }
          }
        })();
      </script>
    </>
  )
}
