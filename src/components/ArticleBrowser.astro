---
import BaseLayout from '../layouts/BaseLayout.astro'
import ResumeCta from './ResumeCta.astro'
import { getOrderedArticles, getArticleTopicGroups } from '../data/articles'
import SidebarCollapse from './SidebarCollapse.astro'
import HomeStart from './HomeStart.astro'
import {
	CATEGORIES,
	MODULE_META,
	SITE,
	type Category,
	type ModuleKey
} from '../data/site'
import { absoluteUrl, url } from '../utils'
import '../styles/article-browser.css'

interface Props {
	module?: ModuleKey
	category?: Category
}

const { module, category } = Astro.props
const meta = module ? MODULE_META[module] : undefined
const scopePath = meta?.href ?? '/'
const pagePath = category ? `/${category.slug}/` : scopePath
const defaultTitle = meta?.name ?? SITE.homeHeading
const defaultIntro =
	module === 'interview'
		? '从工程场景出发，讲清每道面试题。'
		: module === 'programmer'
			? MODULE_META.programmer.shortIntro
			: module === 'tutorial'
				? '从工具配置到工程实践，每篇讲清一个完整主题。'
				: SITE.homeIntro
const cats = CATEGORIES.filter((c) => !module || c.module === module)
const categoryBySlug = new Map(cats.map((c) => [c.slug, c]))
const ordered = (await getOrderedArticles()).filter(
	(a) => !module || a.module === module
)
const sequence = new Map(ordered.map((a, i) => [a.entry.id, i]))
const latest = [...ordered].sort(
	(a, b) =>
		b.entry.data.date.getTime() - a.entry.data.date.getTime() ||
		b.entry.data.qnum.localeCompare(a.entry.data.qnum)
)
const initialList = latest.filter(
	(a) => !category || a.entry.data.category === category.slug
)
const articlesByCategory = new Map(
	cats.map((c) => [
		c.slug,
		ordered.filter((article) => article.entry.data.category === c.slug)
	])
)
const counts = new Map(
	cats.map((c) => [
		c.slug,
		articlesByCategory.get(c.slug)!.length
	])
)
const groups: ModuleKey[] = module
	? [module]
	: ['interview', 'programmer', 'tutorial']
const topicGroups = new Map(
	cats.map((c) => [
		c.slug,
		getArticleTopicGroups(
			c.slug,
			articlesByCategory.get(c.slug)!
		)
	])
)
const fmt = (date: Date) => date.toISOString().slice(0, 10)

const jsonLd: Record<string, unknown>[] = [
	{
		'@context': 'https://schema.org',
		'@type': 'ItemList',
		name: category?.name ?? defaultTitle,
		numberOfItems: initialList.length,
		itemListElement: initialList.map(({ entry }, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			name: entry.data.title,
			url: absoluteUrl(`/${entry.id}/`)
		}))
	}
]
if (!module)
	jsonLd.unshift({
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		'@id': `${absoluteUrl('/')}#website`,
		name: SITE.name,
		url: absoluteUrl('/'),
		description: SITE.description,
		inLanguage: 'zh-CN',
		alternateName: 'AIGuide',
		publisher: { '@type': 'Organization', name: SITE.author }
	})
if (module) {
	const crumbs = [
		{ '@type': 'ListItem', position: 1, name: '首页', item: absoluteUrl('/') },
		{
			'@type': 'ListItem',
			position: 2,
			name: meta!.title,
			item: absoluteUrl(meta!.href)
		},
		...(category
			? [
					{
						'@type': 'ListItem',
						position: 3,
						name: category.name,
						item: absoluteUrl(pagePath)
					}
				]
			: [])
	]
	jsonLd.push({
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: crumbs
	})
}
jsonLd.push({
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: category?.name ?? meta?.title ?? SITE.name,
	description: category?.intro ?? meta?.description ?? SITE.description,
	url: absoluteUrl(pagePath),
	inLanguage: 'zh-CN',
	isPartOf: {
		'@type': 'WebSite',
		'@id': `${absoluteUrl('/')}#website`,
		name: SITE.name,
		url: absoluteUrl('/')
	}
})
---

<BaseLayout
	title={category?.name ?? meta?.title ?? SITE.name}
	description={category?.intro ?? meta?.description ?? SITE.description}
	path={pagePath}
	customSidebar
	noindex={initialList.length === 0}
>
	<script
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
	/>
	<div
		class="article-browser"
		data-article-browser
		data-scope-path={url(scopePath)}
		data-default-path={url(pagePath)}
		data-default-category={category?.slug ?? ''}
		data-title={defaultTitle}
		data-intro={defaultIntro}
	>
		<aside
			class="browse-sidebar"
			id="browse-sidebar"
			aria-label="文章分类"
			data-site-sidebar
			data-sidebar-scope={module ?? 'home'}
			data-sidebar-kind="browse"
			data-pagefind-ignore
		>
			<div class="sidebar-heading">
				<p class="sb-title">
					{meta ? `${meta.name} · 分类` : '文章分类'}
				</p><SidebarCollapse />
			</div>
			<nav aria-label="按主题阅读" class="browse-categories">
				{cats.map((c) => (
					<span hidden data-browse-category data-filter-category={c.slug}
						data-category-title={c.name} data-category-label={c.nav}
						data-category-intro={c.intro} data-category-module={c.module} />
				))}
				<a
					href={url(scopePath)}
					class="browse-category"
					data-filter-category=""
					aria-current={!category ? 'true' : undefined}
				>
					<span>全部文章</span><span class="browse-count">{ordered.length}</span
					>
				</a>
				{
					groups.map((group) => (
						<details
							class="browse-group"
							open
							data-sidebar-module={group}
							data-sidebar-node={!module ? `module:${group}` : undefined}
						>
							<summary class="browse-group-label" hidden={!!module}>
								{MODULE_META[group].name}
							</summary>
							{cats
								.filter((c) => c.module === group)
								.map((c) => (
									<div class="browse-category-branch">
										<a href={url(`/${c.slug}/`)}
											class:list={['browse-category', topicGroups.get(c.slug)!.length > 0 && 'has-topics']}
											data-filter-category={c.slug}
											aria-current={category?.slug === c.slug ? 'true' : undefined}>
											<span>{c.nav}</span><span class="browse-count">{counts.get(c.slug)}</span>
										</a>
										{topicGroups.get(c.slug)!.length > 0 && <details
											class="browse-topics" data-sidebar-node={`category:${c.slug}`}
											data-sidebar-category={c.slug}
											data-sidebar-current={category?.slug === c.slug ? 'true' : undefined}
											open={category?.slug === c.slug}>
											<summary aria-label={`${c.nav}下级分类`} title="展开或收起下级分类">
												<svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m7.5 5 5 5-5 5" /></svg>
											</summary>
											<div class="browse-children">
												{topicGroups.get(c.slug)!.map((topic) => (
													<a href={url(`/${c.slug}/?topic=${encodeURIComponent(topic.id)}`)}
														class="browse-topic" data-filter-category={c.slug}
														data-filter-topic={topic.id} data-topic-name={topic.name}>
														<span>{topic.name}</span><span class="browse-count">{topic.articles.length}</span>
													</a>
												))}
											</div>
										</details>}
									</div>
								))}
						</details>
					))
				}
			</nav>
			<div class="browse-recommendation">
				<ResumeCta variant="sidebar" />
			</div>
		</aside>
		<section
			class="browse-content"
			aria-labelledby="browse-title"
			data-pagefind-ignore
		>
			{!module && !category && <HomeStart />}
			<header class="browse-heading">
				<h1 id="browse-title" tabindex="-1">
					{category?.name ?? defaultTitle}
				</h1>
				<p class="browse-intro" data-browser-intro>
					{category?.intro ?? defaultIntro}
				</p>
			</header>
			<div class="browse-toolbar">
				<p
					class="browse-result-count"
					data-result-count
					aria-live="polite"
					aria-atomic="true"
				>
					共 {initialList.length} 篇文章
				</p>
				<label class="browse-sort" data-browser-enhanced hidden>
					<span>排序</span>
					<select data-browser-sort aria-label="文章排序"
						><option value="latest">最近更新</option><option value="series"
							>按分类顺序</option
						></select
					>
				</label>
			</div>
			<ul class="browse-posts" data-browser-posts>
				{
					latest.map(({ entry, module: articleModule }, i) => {
						const cat = categoryBySlug.get(entry.data.category)!
						return (
							<li
								class="browse-post"
								data-article-category={cat.slug}
								data-article-module={articleModule}
								data-article-reading-topic={topicGroups.get(cat.slug)!.length ? entry.data.topic ?? `${cat.slug}:other` : ''}
								data-article-topic={entry.data.topic ?? `${cat.slug}:other`}
								data-latest-order={i}
								data-series-order={sequence.get(entry.id)}
								hidden={!!category && cat.slug !== category.slug}
							>
								<article>
									<div class="browse-post-meta">
										<>
											<a
												class="browse-module"
												href={url(MODULE_META[articleModule].href)}
											>
												{MODULE_META[articleModule].name}
											</a>
											<span aria-hidden="true">·</span>
										</>
										<>
											<a
												href={url(`/${cat.slug}/`)}
												data-filter-category={cat.slug}
											>
												{cat.nav}
											</a>
											<span aria-hidden="true">·</span>
										</>
										<time datetime={fmt(entry.data.date)}>
											更新于 {fmt(entry.data.date)}
										</time>
									</div>
									<h2>
										<a href={url(`/${entry.id}/`)} data-article-link>{entry.data.title}</a>
									</h2>
									<p class="browse-excerpt">{entry.data.description}</p>
								</article>
							</li>
						)
					})
				}
			</ul>
			<div
				class="browse-empty"
				data-browser-empty
				hidden={initialList.length > 0}
			>
				<h2>
					{
						module === 'programmer' && ordered.length === 0
							? '全栈面试题正在准备中'
							: '这个分类还没有文章'
					}
				</h2>
				<p>
					{
						module === 'programmer' && ordered.length === 0
							? '这里将按题目收录前端、后端、数据库、网络与并发等全栈面试文章，完成后会陆续加入。'
							: '先看看其他主题，内容会持续更新。'
					}
				</p>
				<a
					href={url(ordered.length === 0 ? '/' : scopePath)}
					data-filter-category={ordered.length > 0 ? '' : undefined}
					>查看全部文章 <span aria-hidden="true">→</span></a
				>
			</div>
			<nav
				class="browse-pagination"
				aria-label="文章分页"
				data-browser-pagination
				hidden
			>
				<span data-page-status></span>
				<div>
					<button type="button" data-page-prev>← 上一页</button><button
						type="button"
						data-page-next>下一页 →</button
					>
				</div>
			</nav>
		</section>
	</div>
</BaseLayout>

<script>
	import '../scripts/article-browser'
</script>
