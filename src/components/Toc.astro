---
// 文章右侧目录：由 Markdown 渲染出的 headings 自动生成
// 展示 1~3 级标题；滚动时高亮当前所在小节（见底部脚本）

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth >= 1 && h.depth <= 3 && h.text);
---

{
  items.length > 2 && (
    <aside class="toc" data-pagefind-ignore aria-label="文章目录">
      <p class="toc-title">目录</p>
      <ul>
        {items.map((h) => (
          <li class:list={[`lv-${h.depth}`]}>
            <a href={`#${h.slug}`} data-toc-link={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}

<script>
  // 滚动高亮：用 IntersectionObserver 找出当前视口内最近的小节标题
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")
  );
  if (links.length > 0) {
    const byId = new Map(
      links.map((a) => [a.dataset.tocLink!, a] as const)
    );
    const targets = links
      .map((a) => document.getElementById(a.dataset.tocLink!))
      .filter((el): el is HTMLElement => el !== null);

    const setCurrent = (id: string) => {
      links.forEach((a) => a.classList.remove("current"));
      byId.get(id)?.classList.add("current");
    };

    // 默认高亮第一项
    setCurrent(byId.keys().next().value as string);

    const visible = new Map<string, number>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            visible.set(e.target.id, e.boundingClientRect.top);
          } else {
            visible.delete(e.target.id);
          }
        }
        // 取视口中最靠上的可见标题；一个都不可见时取最后一个滚过去的
        if (visible.size > 0) {
          let best: string | null = null;
          let bestTop = Infinity;
          for (const [id, top] of visible) {
            if (top < bestTop) {
              bestTop = top;
              best = id;
            }
          }
          if (best) setCurrent(best);
        } else if (targets.length > 0) {
          const passed = targets.filter(
            (el) => el.getBoundingClientRect().top < 120
          );
          if (passed.length > 0) {
            setCurrent(passed[passed.length - 1].id);
          }
        }
      },
      { rootMargin: "-72px 0px -60% 0px", threshold: 0 }
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
