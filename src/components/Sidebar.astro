---
import { CATEGORIES, MODULE_META } from "../data/site";
import { getArticlesByCategory, getArticleTopicGroups } from "../data/articles";
import SidebarArticles from "./SidebarArticles.astro";
import SidebarCollapse from "./SidebarCollapse.astro";
import { url } from "../utils";

const byCat = await getArticlesByCategory();
const current = [...byCat.values()].flat().find(({ entry }) => Astro.url.pathname === url(`/${entry.id}/`));
const category = CATEGORIES.find((item) => item.slug === current?.entry.data.category);
const items = category ? byCat.get(category.slug) ?? [] : [];
const topic = category && current
  ? getArticleTopicGroups(category.slug, items).find((group) => group.articles.some(({ entry }) => entry.id === current.entry.id))
  : undefined;
const reading = topic?.articles ?? items;
const module = current?.module ?? "interview";
const meta = MODULE_META[module];
const backHref = category ? url(`/${category.slug}/`) + (topic ? `?topic=${encodeURIComponent(topic.id)}` : "") : url(meta.href);
const returnPaths = [url("/"), url(meta.href), ...CATEGORIES.filter((item) => item.module === module).map((item) => url(`/${item.slug}/`))];
---

<aside class="sidebar reading-sidebar" id="article-sidebar" aria-label="阅读目录" data-site-sidebar data-sidebar-scope={module} data-sidebar-kind="reading" data-pagefind-ignore>
  <div class="sidebar-heading">
    <p class="sb-title">阅读目录</p>
    <SidebarCollapse />
  </div>
  <a class="sb-back" href={backHref} data-navigation-return
    data-return-category={category?.slug} data-return-topic={topic?.id ?? ""}
    data-return-paths={JSON.stringify(returnPaths)}>← 全部分类</a>
  <p class="sb-path">{meta.name}{topic && category && <> / {category.nav}</>}</p>
  <div class="sb-reading-heading">
    <h2 id="reading-directory-title">{topic?.name ?? category?.nav ?? meta.name}</h2>
    <span class="sb-reading-count">{reading.length} 篇</span>
  </div>
  <nav aria-labelledby="reading-directory-title">
    <SidebarArticles articles={reading} flat showNumber={false} />
  </nav>
</aside>
