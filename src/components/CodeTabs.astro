---
// 语言切换代码块的交互脚本
// HTML 结构由构建时的 rehype 插件（src/lib/rehype-code-tabs.mjs）生成，这里只负责切换行为：
//  - 同一篇文章内所有代码块的语言选择保持同步
//  - 记住上次选的语言（localStorage）
//  - 支持左右方向键切换
---

<script>
  const groups = Array.from(document.querySelectorAll<HTMLElement>(".code-tabs"));

  if (groups.length > 0) {
    const STORE_KEY = "code-lang";

    const activate = (group: HTMLElement, lang: string) => {
      const tabs = Array.from(
        group.querySelectorAll<HTMLButtonElement>(".code-tab")
      );
      const panels = Array.from(
        group.querySelectorAll<HTMLElement>(".code-panel")
      );
      let matched = false;

      for (const tab of tabs) {
        const on = tab.dataset.codeLang === lang;
        tab.classList.toggle("is-active", on);
        tab.setAttribute("aria-selected", String(on));
        if (on) matched = true;
      }
      for (const panel of panels) {
        const on = panel.dataset.codeLang === lang;
        panel.classList.toggle("is-active", on);
        panel.hidden = !on;
      }
      return matched;
    };

    const applyAll = (lang: string) => {
      for (const group of groups) activate(group, lang);
    };

    // 恢复上次选择的语言
    let saved: string | null = null;
    try {
      saved = localStorage.getItem(STORE_KEY);
    } catch {}
    if (saved) applyAll(saved);

    for (const group of groups) {
      const tabs = Array.from(
        group.querySelectorAll<HTMLButtonElement>(".code-tab")
      );

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => {
          const lang = tab.dataset.codeLang;
          if (!lang) return;
          applyAll(lang);
          try {
            localStorage.setItem(STORE_KEY, lang);
          } catch {}
        });

        tab.addEventListener("keydown", (event) => {
          if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
          event.preventDefault();
          const step = event.key === "ArrowRight" ? 1 : -1;
          const next = (index + step + tabs.length) % tabs.length;
          tabs[next].focus();
          tabs[next].click();
        });
      });
    }
  }
</script>
