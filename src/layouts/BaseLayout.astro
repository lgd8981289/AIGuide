---
import "../styles/global.css";
import Topbar from "../components/Topbar.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import SearchDialog from "../components/SearchDialog.astro";
import FollowModal from "../components/FollowModal.astro";
import { SITE, moduleOfPath } from "../data/site";
import { url, absoluteUrl } from "../utils";

interface Props {
  title: string;
  description?: string;
  /** 站内路径（不含 base 前缀），如 "/agent/q001-x/"，用于 canonical */
  path?: string;
  /** 是否显示左侧系列目录（分类页、文章页用） */
  sidebar?: boolean;
  /** og:type：文章页用 article，其余用 website */
  ogType?: "website" | "article";
}

const {
  title,
  description = SITE.description,
  path = "/",
  sidebar = false,
  ogType = "website",
} = Astro.props;

// 当前页面所属模块：顶部导航高亮与侧边栏分组都用它
const activeModule = moduleOfPath(path);

const pageTitle =
  path === "/" ? `${SITE.name}｜${SITE.tagline}` : `${title}｜${SITE.name}`;
const canonical = absoluteUrl(path);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={absoluteUrl("/og-cover.jpg")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteUrl("/og-cover.jpg")} />
    <script is:inline>
      // 主题初始化：优先读取用户选择，否则跟随系统（在任何内容渲染前执行，避免闪烁）
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t !== "light" && t !== "dark") {
            t = window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          }
          document.documentElement.dataset.theme = t;
        } catch (e) {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <input
      type="checkbox"
      id="sidebar-toggle"
      class="nav-toggle-input"
      aria-hidden="true"
      tabindex="-1"
    />
    <Topbar activeModule={activeModule} />
    <div class:list={["shell", !sidebar && "no-sidebar"]}>
      {sidebar && <Sidebar module={activeModule} />}
      <main>
        <slot />
      </main>
    </div>
    <Footer />
    <SearchDialog />
    <FollowModal />
  </body>
</html>
