---
import "../styles/global.css";
import { brandedTitle, brandedDescription } from "../lib/brand.mjs";
import Topbar from "../components/Topbar.astro";
import Sidebar from "../components/Sidebar.astro";
import CourseSidebar from "../components/CourseSidebar.astro";
import Footer from "../components/Footer.astro";
import SearchDialog from "../components/SearchDialog.astro";
import FollowModal from "../components/FollowModal.astro";
import { FOLLOW, SITE, SITE_VERIFICATION, moduleOfPath } from "../data/site";
import { url, absoluteUrl } from "../utils";

interface Props {
  title: string;
  description?: string;
  /** 站内路径（不含 base 前缀），如 "/agent/q001-x/"，用于 canonical */
  path?: string;
  /** 是否显示左侧系列目录（分类页、文章页用） */
  sidebar?: boolean;
  /** 列表页在自己的布局内提供分类侧栏。 */
  customSidebar?: boolean;
  /** og:type：文章页用 article，其余用 website */
  ogType?: "website" | "article";
  noindex?: boolean;
  keywords?: string[];
  /** 社交分享与结构化数据用图；文章页传正文首图，未传则用站点通用封面 */
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  activeModule?: ReturnType<typeof moduleOfPath>;
}

const {
  title,
  description = SITE.description,
  path = "/",
  sidebar = false,
  customSidebar = false,
  ogType = "website",
  noindex = false,
  keywords,
  ogImage = "/og-cover.jpg",
  ogImageWidth = 1200,
  ogImageHeight = 630,
} = Astro.props;

// 当前页面所属模块：顶部导航高亮与侧边栏分组都用它
const activeModule = Astro.props.activeModule ?? moduleOfPath(path);
const hasSidebar = sidebar || customSidebar;

// 品牌只追加一次，具体问题放在标题前面；保留每篇文章自己的描述。
const pageTitle = path === "/" ? SITE.homeTitle : brandedTitle(title);
const pageDescription = brandedDescription(description);
const canonical = absoluteUrl(path);
const ogImageUrl = /^https?:\/\//.test(ogImage) ? ogImage : absoluteUrl(ogImage);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {keywords && <meta name="keywords" content={keywords.join(", ")} />}
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="180x180" href={url("/apple-touch-icon.png")} />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />
    <meta name="generator" content={Astro.generator} />
    {SITE_VERIFICATION.baidu && (
      <meta name="baidu-site-verification" content={SITE_VERIFICATION.baidu} />
    )}
    {SITE_VERIFICATION.google && (
      <meta name="google-site-verification" content={SITE_VERIFICATION.google} />
    )}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <!-- 51.LA 全站访问统计；保留内联脚本，按官方方式异步加载 SDK。 -->
    <script is:inline>
      !function(p){"use strict";!function(t){var s=window,e=document,i=p,c="".concat("https:"===e.location.protocol?"https://":"http://","sdk.51.la/js-sdk-pro.min.js"),n=e.createElement("script"),r=e.getElementsByTagName("script")[0];n.type="text/javascript",n.setAttribute("charset","UTF-8"),n.async=!0,n.src=c,n.id="LA_COLLECT",i.d=n;var o=function(){s.LA.ids.push(i)};s.LA?s.LA.ids&&o():(s.LA=p,s.LA.ids=[],o()),r.parentNode.insertBefore(n,r)}()}({id:"3RLhnol3nj3ui0Lt",ck:"3RLhnol3nj3ui0Lt"});
    </script>
    {hasSidebar && <script is:inline>
      try {
        document.documentElement.dataset.sidebarCollapsed = String(localStorage.getItem("aiguide.sidebar.v1") === "collapsed");
      } catch {}
    </script>}
    <script is:inline>
      // 主题初始化：优先读取用户选择，否则跟随系统（在任何内容渲染前执行，避免闪烁）
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t !== "light" && t !== "dark") {
            t = window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          }
          document.documentElement.dataset.theme = t;
        } catch (e) {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <Topbar activeModule={activeModule} showSidebar={hasSidebar} sidebarId={customSidebar ? "browse-sidebar" : "article-sidebar"} />
    {hasSidebar && <button type="button" class="sidebar-backdrop" aria-label="关闭目录" tabindex="-1" data-sidebar-close />}
    <div class:list={["shell", !sidebar && "no-sidebar", sidebar && "with-article-sidebar"]}>
      {sidebar && (activeModule === "course" ? <CourseSidebar /> : <Sidebar />)}
      <main>
        <slot />
      </main>
    </div>
    <Footer />
    <SearchDialog />
    {FOLLOW.enabled && <FollowModal />}
  </body>
</html>

<script>
  import "../scripts/sidebar";
</script>
