---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TechGrow from "../../components/TechGrow.astro";
import ResumeCta from "../../components/ResumeCta.astro";
import ReadingGuideCta from "../../components/ReadingGuideCta.astro";
import Toc from "../../components/Toc.astro";
import BackTop from "../../components/BackTop.astro";
import ImmersiveToggle from "../../components/ImmersiveToggle.astro";
import CodeTabs from "../../components/CodeTabs.astro";
import CopyGuard from "../../components/CopyGuard.astro";
import CodeCopy from "../../components/CodeCopy.astro";
import ImageZoom from "../../components/ImageZoom.astro";
import { CATEGORIES, COPY_GUARD, MODULE_META, SITE, TECHGROW, categoriesOf, selectGatedArticles } from "../../data/site";
import { getArticlesByCategory } from "../../data/articles";
import { ARTICLE_RELATED } from "../../data/article-related";
import { selectRelatedArticles } from "../../lib/related-articles.mjs";
import { url, absoluteUrl } from "../../utils";

export async function getStaticPaths() {
  const byCat = await getArticlesByCategory();
  const paths = [];
  for (const list of byCat.values()) {
    for (const item of list) {
      // entry.id 形如 "agent/q001-agent-vs-workflow"
      const [category, slug] = item.entry.id.split("/");
      paths.push({
        params: { category, slug },
        props: { entry: item.entry, displayNum: item.displayNum },
      });
    }
  }
  return paths;
}

const { entry, displayNum } = Astro.props;
const { Content, headings } = await render(entry);

const cat = CATEGORIES.find((c) => c.slug === entry.data.category)!;
const meta = MODULE_META[cat.module];
const pagePath = `/${entry.id}/`;
const pageUrl = absoluteUrl(pagePath);
const dateISO = entry.data.date.toISOString().slice(0, 10);
const publishedDateISO = (entry.data.publishedDate ?? entry.data.date).toISOString().slice(0, 10);

// 同分类内按展示序号取上下篇
const siblings = (await getArticlesByCategory()).get(cat.slug) ?? [];
const idx = siblings.findIndex((s) => s.entry.id === entry.id);
const prev = idx > 0 ? siblings[idx - 1] : null;
const next = idx >= 0 && idx < siblings.length - 1 ? siblings[idx + 1] : null;

// 相关文章（内链）：先同分类的其他文章，不够再从同模块补齐
const byCat = await getArticlesByCategory();
const sameCat = siblings.filter((s) => s.entry.id !== entry.id);
const sameModule = categoriesOf(cat.module)
  .flatMap((c) => (c.slug === cat.slug ? [] : byCat.get(c.slug) ?? []))
  .filter((s) => s.entry.id !== entry.id);
const related = selectRelatedArticles(entry.data.qnum, [...byCat.values()].flat(),
  ARTICLE_RELATED[entry.data.qnum] ?? [], [...sameCat, ...sameModule]);

const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(
    d.getDate()
  ).padStart(2, "0")}`;

// 构建时确定本页是否门禁：既要有可切分的边界（存在二级标题），也要命中本分类的抽样结果。
// 结果同时驱动前端脚本与下方的 isAccessibleForFree，避免两者不一致。
const gated = TECHGROW.enabled
  && headings.some((heading) => heading.depth === 2)
  && selectGatedArticles(siblings.map((s) => s.entry.id)).has(entry.id);

// 速答属于文章摘要；受限内容与实际正文 .gated-content 对应。
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: entry.data.title,
    description: entry.data.description,
    ...(entry.data.faqAnswer ? { abstract: entry.data.faqAnswer } : {}),
    isAccessibleForFree: !gated,
    ...(gated ? {
      hasPart: {
        "@type": "WebPageElement",
        isAccessibleForFree: false,
        cssSelector: ".gated-content",
      },
    } : {}),
    datePublished: publishedDateISO,
    dateModified: dateISO,
    inLanguage: "zh-CN",
    articleSection: cat.name,
    author: {
      "@type": "Person",
      name: SITE.author,
    },
    publisher: {
      "@type": "Organization",
      name: SITE.name,
      logo: {
        "@type": "ImageObject",
        url: absoluteUrl(SITE.logo || "/favicon.svg"),
      },
    },
    isPartOf: {
      "@type": "WebSite",
      name: SITE.name,
      url: absoluteUrl("/"),
    },
    mainEntityOfPage: pageUrl,
    image: absoluteUrl("/og-cover.jpg"),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "首页",
        item: absoluteUrl("/"),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: meta.title,
        item: absoluteUrl(meta.href),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: cat.name,
        item: absoluteUrl(`/${cat.slug}/`),
      },
      { "@type": "ListItem", position: 4, name: entry.data.title, item: pageUrl },
    ],
  },
];

---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  path={pagePath}
  sidebar
  ogType="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={publishedDateISO} />
    <meta property="article:modified_time" content={dateISO} />
    <meta property="article:author" content={SITE.author} />
    <meta property="article:section" content={cat.name} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
  </Fragment>

  <div class="article-layout with-toc">
    <div class="article-col">
      <article
        data-pagefind-body
        class={COPY_GUARD.enabled ? "article-guard" : ""}
        style="padding-bottom: 30px;"
      >
        <div class="page-head">
          <div class="crumbs" data-pagefind-ignore>
            <a href={url("/")}>首页</a> /{" "}
            <a href={url(meta.href)}>{meta.title}</a> /{" "}
            <a href={url(`/${cat.slug}/`)}>{cat.name}</a>
          </div>
          <h1 data-pagefind-meta="title">{entry.data.title}</h1>
          <div class="article-meta" data-pagefind-ignore>
            <a class="cat" data-pagefind-meta="category" href={url(`/${cat.slug}/`)}>
              {cat.name}
            </a>
            <span>{displayNum}</span>
            <span>更新于 {fmt(entry.data.date)}</span>
            <ImmersiveToggle />
          </div>
        </div>

        <div id="readmore-container" class="prose">
          <Content />
        </div>

        {
          (prev || next) && (
            <nav class="prev-next" data-pagefind-ignore>
              {prev ? (
                <a href={url(`/${prev.entry.id}/`)}>
                  <span class="label">{meta.prevLabel} · {prev.displayNum}</span>
                  {prev.entry.data.title}
                </a>
              ) : (
                <span />
              )}
              {next ? (
                <a class="next" href={url(`/${next.entry.id}/`)}>
                  <span class="label">{meta.nextLabel} · {next.displayNum}</span>
                  {next.entry.data.title}
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }
      </article>

      <ReadingGuideCta category={cat.slug} module={cat.module} />

      {
        related.length > 0 && (
          <nav class="related" aria-label="相关文章">
            <h2 class="related-title">相关阅读</h2>
            <ul>
              {related.map(({ entry: item, displayNum }) => (
                <li>
                  <a href={url(`/${item.id}/`)}>
                    <span class="qnum">{displayNum}</span>
                    <span class="t">{item.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <ResumeCta variant="inline" />
    </div>

    <Toc headings={headings} />
  </div>

  <BackTop />

  <CodeTabs />

  <CodeCopy />

  <ImageZoom />

  <CopyGuard />

  <TechGrow gated={gated} />
</BaseLayout>
