---
import ArticleCompanies from "../../components/ArticleCompanies.astro";
import ArticleInterviewQuestions from "../../components/ArticleInterviewQuestions.astro";
import { realQuestionsForArticle, questionTags, interviewDescription } from "../../lib/company-interviews.mjs";
import { render } from "astro:content";
import { brandedDescription } from "../../lib/brand.mjs";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TechGrow from "../../components/TechGrow.astro";
import ResumeCta from "../../components/ResumeCta.astro";
import ReadingGuideCta from "../../components/ReadingGuideCta.astro";
import WechatCta from "../../components/WechatCta.astro";
import Toc from "../../components/Toc.astro";
import BackTop from "../../components/BackTop.astro";
import ImmersiveToggle from "../../components/ImmersiveToggle.astro";
import CodeTabs from "../../components/CodeTabs.astro";
import CopyGuard from "../../components/CopyGuard.astro";
import CodeCopy from "../../components/CodeCopy.astro";
import ImageZoom from "../../components/ImageZoom.astro";
import { CATEGORIES, COPY_GUARD, MODULE_META, SITE, TECHGROW, selectGatedArticles } from "../../data/site";
import { getArticleSeoTitle, getArticlesByCategory } from "../../data/articles";
import { getRelatedArticles } from "../../data/article-related";
import { authorSchema, publisherSchema, websiteSchema } from "../../data/structured-data";
import { extractFaqPairs } from "../../lib/faq.mjs";
import { resolveArticleImage } from "../../lib/article-image.mjs";
import { url, absoluteUrl } from "../../utils";

export async function getStaticPaths() {
  const byCat = await getArticlesByCategory();
  const paths = [];
  for (const list of byCat.values()) {
    for (const item of list) {
      // entry.id 形如 "agent/q001-agent-vs-workflow"
      const [category, slug] = item.entry.id.split("/");
      paths.push({
        params: { category, slug },
        props: { entry: item.entry, displayNum: item.displayNum },
      });
    }
  }
  return paths;
}

const { entry, displayNum } = Astro.props;
const seoTitle = getArticleSeoTitle(entry);
const companyMatches = realQuestionsForArticle(entry.data.qnum);
const description = interviewDescription(entry.data.description, companyMatches);
const { Content, headings } = await render(entry);
const articleHeadings = [...headings, { depth: 2, slug: 'company-interview-questions', text: '公司面试真题' }];
const firstH2 = headings.find((heading) => heading.depth === 2);

function buildTldr(raw?: string): string {
  const clean = (raw ?? "").replace(/\s+/g, " ").trim();
  if (!clean) return "";
  if (clean.length <= 180) return clean;
  const sentences = clean.match(/[^。！？]+[。！？]/g) ?? [];
  let acc = "";
  for (const s of sentences) {
    if (acc && acc.length + s.length > 180) break;
    acc += s;
    if (acc.length >= 90) break;
  }
  return acc || clean.slice(0, 180).replace(/[，、；：,\s]+$/, "") + "。";
}
const tldr = buildTldr(entry.data.faqAnswer);

const cat = CATEGORIES.find((c) => c.slug === entry.data.category)!;
const meta = MODULE_META[cat.module];
const pagePath = `/${entry.id}/`;
const pageUrl = absoluteUrl(pagePath);
const dateISO = entry.data.date.toISOString().slice(0, 10);
const publishedDateISO = (entry.data.publishedDate ?? entry.data.date).toISOString().slice(0, 10);

// 同分类内按展示序号取上下篇
const siblings = (await getArticlesByCategory()).get(cat.slug) ?? [];
const idx = siblings.findIndex((s) => s.entry.id === entry.id);
const prev = idx > 0 ? siblings[idx - 1] : null;
const next = idx >= 0 && idx < siblings.length - 1 ? siblings[idx + 1] : null;

const related = await getRelatedArticles(entry.data.qnum);

const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(
    d.getDate()
  ).padStart(2, "0")}`;

// 构建时确定本页是否门禁：既要有可切分的边界（存在二级标题），也要命中本分类的抽样结果。
// 结果同时驱动前端脚本与下方的 isAccessibleForFree，避免两者不一致。
const gated = TECHGROW.enabled
  && headings.some((heading) => heading.depth === 2)
  && selectGatedArticles(siblings.map((s) => s.entry.id)).has(entry.id);

// 「面试官继续追问」板块的问答对。这些 H3 问句与紧随其后的答案本来就渲染在页面上，
// 问答全部来自正文，不新增、不改写任何文字。
const faqs = extractFaqPairs(entry.body ?? "");

// 正文首图：让每篇文章的结构化数据与社交分享用上自己的示意图，
// 而不是 379 篇共用一张 og-cover.jpg。取不到合格的图时回落到通用封面。
const coverImage = resolveArticleImage(entry.body ?? "");
const coverImageUrl = coverImage
  ? absoluteUrl(coverImage.src)
  : absoluteUrl("/og-cover.jpg");

// 速答属于文章摘要；受限内容与实际正文 .gated-content 对应。
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: entry.data.title,
    description: brandedDescription(description),
    ...(entry.data.faqAnswer ? { abstract: entry.data.faqAnswer } : {}),
    isAccessibleForFree: !gated,
    ...(gated ? {
      hasPart: {
        "@type": "WebPageElement",
        isAccessibleForFree: false,
        cssSelector: ".gated-content",
      },
    } : {}),
    ...(companyMatches.length ? { citation: [...new Set(companyMatches.map(m => m.source.url))], keywords: questionTags(entry.data.qnum).map(t => t.label) } : {}),
    datePublished: publishedDateISO,
    dateModified: dateISO,
    inLanguage: "zh-CN",
    articleSection: cat.name,
    author: authorSchema,
    publisher: publisherSchema,
    isPartOf: websiteSchema,
    mainEntityOfPage: pageUrl,
    // 有文章自己的配图时用 ImageObject 带上真实尺寸，满足 Discover 对 1200px 大图的要求
    image: coverImage
      ? {
          "@type": "ImageObject",
          url: coverImageUrl,
          width: coverImage.w,
          height: coverImage.h,
        }
      : coverImageUrl,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "首页",
        item: absoluteUrl("/"),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: meta.title,
        item: absoluteUrl(meta.href),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: cat.name,
        item: absoluteUrl(`/${cat.slug}/`),
      },
      { "@type": "ListItem", position: 4, name: entry.data.title, item: pageUrl },
    ],
  },
  // FAQPage 与可见问答一致。Google 自 2026-05-07 停止展示 FAQ 富结果；
  // 保留语义标记不代表能提高排名或获得 AI Overviews 引用。
  ...(faqs.length > 0
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: faqs.map(({ q, a }) => ({
            "@type": "Question",
            name: q,
            acceptedAnswer: { "@type": "Answer", text: a },
          })),
        },
      ]
    : []),
];

---

<BaseLayout
  title={seoTitle}
  description={description}
  path={pagePath}
  sidebar
  ogType="article"
  ogImage={coverImageUrl}
  ogImageWidth={coverImage ? coverImage.w : undefined}
  ogImageHeight={coverImage ? coverImage.h : undefined}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={publishedDateISO} />
    <meta property="article:modified_time" content={dateISO} />
    <meta property="article:author" content={SITE.author} />
    <meta property="article:section" content={cat.name} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
  </Fragment>

  <div class="article-layout with-toc">
    <div class="article-col">
      <article
        data-pagefind-body
        class={COPY_GUARD.enabled ? "article-guard" : ""}
        style="padding-bottom: 30px;"
      >
        <div class="page-head">
          <div class="crumbs" data-pagefind-ignore>
            <a href={url("/")}>首页</a> /{" "}
            <a href={url(meta.href)}>{meta.title}</a> /{" "}
            <a href={url(`/${cat.slug}/`)}>{cat.name}</a>
          </div>
          <h1 data-pagefind-meta="title">{entry.data.title}</h1>
          <ArticleCompanies qnum={entry.data.qnum} />
          <div class="article-meta" data-pagefind-ignore>
            <span>{SITE.author} · {SITE.name}</span>
            <a class="cat" data-pagefind-meta="category" href={url(`/${cat.slug}/`)}>
              {cat.name}
            </a>
            <span>{displayNum}</span>
            <span>更新于 {fmt(entry.data.date)}</span>
            <ImmersiveToggle />
          </div>
        </div>

        {
          tldr && (
            <section class="tldr-card" aria-label="核心结论" data-pagefind-ignore>
              <div class="tldr-head">
                <span class="tldr-kicker">核心结论 · 30 秒速览</span>
                {firstH2 && (
                  <a class="tldr-jump" href={`#${firstH2.slug}`}>
                    ↓ 查看完整工程拆解与追问
                  </a>
                )}
              </div>
              <p class="tldr-text">{tldr}</p>
            </section>
          )
        }

        <div id="readmore-container" class="prose">
          <Content />
        </div>

        <ArticleInterviewQuestions qnum={entry.data.qnum} />

        {
          (prev || next) && (
            <nav class="prev-next" data-pagefind-ignore>
              {prev ? (
                <a href={url(`/${prev.entry.id}/`)}>
                  <span class="label">{meta.prevLabel} · {prev.displayNum}</span>
                  {prev.entry.data.title}
                </a>
              ) : (
                <span />
              )}
              {next ? (
                <a class="next" href={url(`/${next.entry.id}/`)}>
                  <span class="label">{meta.nextLabel} · {next.displayNum}</span>
                  {next.entry.data.title}
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }
      </article>

      <ReadingGuideCta category={cat.slug} module={cat.module} />

      <WechatCta />

      {
        related.length > 0 && (
          <nav class="related" aria-label="相关文章">
            <h2 class="related-title">相关阅读</h2>
            <ul>
              {related.map(({ entry: item, displayNum }) => (
                <li>
                  <a href={url(`/${item.id}/`)}>
                    <span class="qnum">{displayNum}</span>
                    <span class="t">{item.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <ResumeCta variant="inline" />
    </div>

    <Toc headings={articleHeadings} />
  </div>

  <BackTop />

  <CodeTabs />

  <CodeCopy />

  <ImageZoom />

  <CopyGuard />

  <TechGrow gated={gated} />
</BaseLayout>
