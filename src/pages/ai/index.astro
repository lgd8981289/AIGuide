---
// 「AI 面试题」模块首页：六大系列总入口 + 全站题目总览
// 顶部导航的「AI 面试题」指向这里
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResumeCta from "../../components/ResumeCta.astro";
import { SITE, CATEGORIES } from "../../data/site";
import { getArticlesByCategory, getOrderedArticles } from "../../data/articles";
import { url } from "../../utils";

const byCat = await getArticlesByCategory();
const all = await getOrderedArticles();

const total = all.length;
const started = CATEGORIES.filter((c) => (byCat.get(c.slug) ?? []).length > 0)
  .length;

const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(
    d.getDate()
  ).padStart(2, "0")}`;
---

<BaseLayout
  title="AI 面试题"
  description={`AI 工程面试题库总览：${CATEGORIES.map((c) => c.name.replace("面试题", "")).join("、")}六大系列，每道题都还原成真实工程决策，再压缩成面试现场能说清楚的回答。`}
  path="/ai/"
>
  <div class="page-head">
    <div class="crumbs">
      <a href={url("/")}>首页</a> / AI 面试题
    </div>
    <h1>AI 面试题</h1>
    <p class="desc">
      按六个系列系统刷题。每道题都从一个真实工程场景出发，先还原面试官的追问链路，再给出能落地、经得起追问的回答。
    </p>
    <div class="stats" style="margin-top: 18px;">
      <span><b>{CATEGORIES.length}</b>大系列</span>
      <span><b>{total}</b>道题</span>
      <span><b>{started}</b>个系列已开更</span>
    </div>
  </div>

  <section>
    <h2 class="section-title">面试题系列<small>按分类进入</small></h2>
    <div class="cat-grid">
      {
        CATEGORIES.map((c) => {
          const items = byCat.get(c.slug) ?? [];
          return (
            <a class="cat-card" href={url(`/${c.slug}/`)}>
              <h3>{c.name}</h3>
              <p>{c.intro}</p>
              <div class="meta">
                <b>{items.length}</b> 道题
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <section style="margin-top: 46px;">
    <h2 class="section-title">全部题目<small>按系列分组</small></h2>
    {
      CATEGORIES.map((c) => {
        const items = byCat.get(c.slug) ?? [];
        return (
          <div class="series-group">
            <h3 class="series-group-title">
              <a href={url(`/${c.slug}/`)}>{c.name}</a>
              <span class="cnt">{items.length} 道</span>
            </h3>
            {items.length > 0 ? (
              <ul class="post-list">
                {items.map(({ entry, displayNum }) => (
                  <li>
                    <a href={url(`/${entry.id}/`)}>
                      <span class="qnum">{displayNum}</span>
                      <span class="t">{entry.data.title}</span>
                      <span class="d">{fmt(entry.data.date)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <div class="empty-hint">
                这个系列正在筹备中，题目会在写作完成后第一时间发布。
              </div>
            )}
          </div>
        );
      })
    }
  </section>

  <div style="margin-top: 40px;">
    <ResumeCta variant="inline" />
  </div>
</BaseLayout>
